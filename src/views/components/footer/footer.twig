<!-- ONA Custom Footer - Neural Design & Clean Typography -->
<footer class="neural-footer mt-20 relative z-10">
    <div class="glass-panel border-t border-white/20 backdrop-blur-2xl rounded-t-[3rem] pt-16 pb-8 px-6 md:px-12 bg-sync-surface-container/30">
        <div class="container mx-auto max-w-[1600px]">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-8 mb-12">
                
                <!-- Brand & Description -->
                <div class="lg:col-span-4 flex flex-col items-start">
                    <a href="{{ store.url }}" class="mb-6 flex items-center gap-3 hover:scale-105 transition-transform">
                        {% if store.logo %}
                            <img class="h-12 w-auto object-contain" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }} logo" loading="lazy">
                        {% else %}
                            <span class="font-display-2xl text-[32px] font-extrabold text-sync-primary tracking-tighter">{{ store.name }}</span>
                        {% endif %}
                    </a>
                    
                    {% if store.description %}
                        <p class="font-body-base text-[15px] text-gray-600 leading-relaxed mb-8 max-w-sm">
                            {{ store.description|raw }}
                        </p>
                    {% endif %}
                    
                    <div class="mb-6">
                        <salla-social class="flex gap-3 text-sync-primary hover:text-sync-secondary transition-colors"></salla-social>
                    </div>
                </div>
                
                <!-- Quick Links -->
                <div class="lg:col-span-2 lg:col-start-6">
                    <h3 class="font-title-base text-[18px] font-bold text-sync-primary mb-6">روابط هامة</h3>
                    <salla-menu source="footer" class="text-gray-600 hover:text-sync-primary transition-colors font-body-base text-[15px] flex flex-col gap-3"></salla-menu>
                </div>
                
                <!-- Contacts -->
                <div class="lg:col-span-3">
                    <h3 class="font-title-base text-[18px] font-bold text-sync-primary mb-6">تواصل معنا</h3>
                    <salla-contacts class="text-gray-600 font-body-base text-[15px]"></salla-contacts>
                </div>
                
                <!-- Apps & Badges -->
                <div class="lg:col-span-3 flex flex-col gap-6">
                    <salla-apps-icons></salla-apps-icons>
                    
                    <div class="p-4 rounded-[1.5rem] bg-sync-glass border border-sync-glass-dark flex items-center gap-4 mt-auto">
                        <salla-trust-badges></salla-trust-badges>
                        
                        {% if store.settings.tax.number %}
                            <div class="flex items-center gap-3 border-r border-gray-300 pr-3 mr-3">
                                {% if store.settings.tax.certificate %}
                                    <a class="load-img-onclick hover:scale-110 transition-transform" data-modal-id="modal-value-tax" href="#" alt="{{ store.settings.tax.number }}">
                                        <img width="32" height="40" src="{{'images/tax.png' | cdn(70,70)}}" loading="lazy" class="w-8 rounded-sm shadow-sm" alt="value added tax">
                                    </a>
                                {% endif %}
                                <div class="flex flex-col text-[12px] font-body-base text-gray-500">
                                    <span>{{ trans('common.elements.tax_number') }}</span>
                                    <strong class="text-gray-700">{{ store.settings.tax.number }}</strong>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
                
            </div>
            
            <!-- Copyright & Payments -->
            <div class="border-t border-sync-primary/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-6">
                <span class="font-body-base text-[14px] text-gray-500">
                    {% hook copyright %}
                </span>
                <salla-payments class="grayscale opacity-70 hover:grayscale-0 hover:opacity-100 transition-all duration-300"
                    @payment-select="onPaymentSelect"
                ></salla-payments>
            </div>
        </div>
    </div>
    
    {% if store.settings.tax.certificate %}
        <salla-modal sub-title-first sub-title="{{ trans('common.elements.tax_number') }}" modal-title="{{ store.settings.tax.number }}" id="modal-value-tax">
            <div class="flex justify-center max-w-full p-4">
                <img class="w-full rounded-2xl shadow-ambient" loading="lazy" data-src="{{ store.settings.tax.certificate }}" alt="{{ store.settings.tax.number }}"/>
            </div>
        </salla-modal>
    {% endif %}
</footer>