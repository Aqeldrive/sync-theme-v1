<!-- ATELIER Footer — paper, restrained, no glass -->
<footer class="mt-16 md:mt-20 border-t border-outline bg-white">
    <div class="max-w-[1280px] mx-auto px-4 md:px-8 py-12 md:py-16">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8">
            
            <div class="lg:col-span-4">
                <a href="{{ store.url }}" class="inline-flex items-center gap-3 mb-5">
                    {% if store.logo %}
                        <img class="h-9 w-auto object-contain" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }} logo" loading="lazy">
                    {% else %}
                        <span class="font-display text-[26px] font-extrabold tracking-[-0.03em] text-ink">{{ store.name }}</span>
                    {% endif %}
                </a>
                
                {% if store.description %}
                    <p class="text-[14px] leading-7 text-gray-500 max-w-sm">
                        {{ store.description|raw }}
                    </p>
                {% endif %}
                
                <salla-social class="flex gap-2.5 mt-6 text-ink"></salla-social>
            </div>
            
            <div class="lg:col-span-2 lg:col-start-6">
                <h3 class="text-[13px] font-bold tracking-[0.06em] uppercase text-ink mb-5">روابط هامة</h3>
                <salla-menu source="footer" class="text-[14px] leading-7 text-gray-500 hover:text-ink flex flex-col gap-2.5"></salla-menu>
            </div>
            
            <div class="lg:col-span-3">
                <h3 class="text-[13px] font-bold tracking-[0.06em] uppercase text-ink mb-5">تواصل معنا</h3>
                <salla-contacts class="text-[14px] leading-7 text-gray-500"></salla-contacts>
            </div>
            
            <div class="lg:col-span-3 flex flex-col gap-6">
                <salla-apps-icons></salla-apps-icons>
                
                <div class="rounded-[16px] border border-outline bg-paper p-4 flex items-center gap-4">
                    <salla-trust-badges class="shrink-0"></salla-trust-badges>
                    
                    {% if store.settings.tax.number %}
                        <div class="flex items-center gap-3 border-r border-outline pr-3 mr-1 flex-1 min-w-0">
                            {% if store.settings.tax.certificate %}
                                <a class="shrink-0 hover:opacity-80 transition-opacity" data-modal-id="modal-value-tax" href="#/">
                                    <img width="28" height="36" src="{{'images/tax.png' | cdn(70,70)}}" loading="lazy" class="w-7 rounded" alt="tax">
                                </a>
                            {% endif %}
                            <div class="flex flex-col text-[11px] leading-4 text-gray-500 min-w-0">
                                <span>{{ trans('common.elements.tax_number') }}</span>
                                <strong class="text-ink truncate">{{ store.settings.tax.number }}</strong>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
            
        </div>
        
        <div class="border-t border-outline mt-10 pt-6 flex flex-col md:flex-row justify-between items-center gap-4">
            <span class="text-[13px] text-gray-400">
                {% hook copyright %}
            </span>
            <salla-payments class="grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300"></salla-payments>
        </div>
        
    </div>
    
    {% if store.settings.tax.certificate %}
        <salla-modal sub-title-first sub-title="{{ trans('common.elements.tax_number') }}" modal-title="{{ store.settings.tax.number }}" id="modal-value-tax">
            <div class="flex justify-center p-4">
                <img class="w-full rounded-[16px]" loading="lazy" data-src="{{ store.settings.tax.certificate }}" alt="{{ store.settings.tax.number }}"/>
            </div>
        </salla-modal>
    {% endif %}
</footer>
