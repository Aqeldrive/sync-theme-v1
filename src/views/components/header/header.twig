<!-- ATELIER Header — Centrepoint rigor: 3-col mega flyout + promo image, flat search 14px -->
<header class="floating-header mt-4 mb-6 md:mb-8 px-5 md:px-8 h-[68px] md:h-[72px] flex justify-between items-center">
    <div class="flex items-center gap-5 md:gap-6">
        <a class="lg:hidden w-10 h-10 rounded-full bg-paper border border-outline flex items-center justify-center text-ink hover:bg-white hover:border-lime/40 hover:shadow-ambient transition-all duration-200 atelier" href="#mobile-menu" aria-label="Open navigation">
            <i class="sicon-menu text-[20px]"></i>
        </a>
        
        <a class="navbar-brand flex items-center gap-3" href="{{ store.url }}">
            {% if store.logo %}
                <img fetchpriority="high" class="h-8 md:h-9 w-auto object-contain" loading="eager" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }} logo">
            {% else %}
                <span class="font-display text-[26px] md:text-[28px] font-extrabold text-ink tracking-[-0.03em]">{{ store.name }}</span>
            {% endif %}
        </a>
        
        <div class="hidden lg:flex items-center gap-7 ml-6">
            <custom-main-menu class="text-[14px] font-semibold tracking-[-0.01em]"></custom-main-menu>
        </div>
    </div>
    
    <div class="flex items-center gap-2.5 md:gap-3">
        <div class="hidden md:block w-[320px]">
            <salla-search inline height="40" class="salla-search-atelier bg-[#F8F9FF] border border-outline rounded-[14px] focus-within:bg-white focus-within:border-lime/30 focus-within:shadow-glow transition-all duration-300"></salla-search>
        </div>
        
        {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
            <div class="hidden sm:block">
                <salla-localization-modal show-trigger class="rounded-full"></salla-localization-modal>
            </div>
        {% endif %}
        
        <salla-user-menu avatar-only show-header show-trigger class="rounded-full hover:shadow-ambient transition-shadow"></salla-user-menu>
        
        <salla-cart-summary class="relative text-ink hover:text-forest transition-colors duration-200">
            <i slot="icon" class="sicon-shopping-bag text-[22px]"></i>
        </salla-cart-summary>
    </div>
</header>
<style>
/* Centrepoint mega: 3 cols + promo image — overrides salla default flyout */
@media(min-width:1024px){
  custom-main-menu .sub-menu{ min-width:720px; padding:24px !important; border-radius:16px !important; border:1px solid #E6E9F2 !important; box-shadow:0 20px 60px rgba(10,24,52,0.12) !important; }
  custom-main-menu .sub-menu ul{ columns:3; column-gap:24px; }
  custom-main-menu .sub-menu li a{ font-size:13px !important; font-weight:600 !important; color:#0A1834 !important; padding:6px 0 !important; }
  custom-main-menu .sub-menu li a:hover{ color:#0D3B2E !important; }
}
</style>
