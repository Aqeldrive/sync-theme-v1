{% set important_links = theme.settings.get('important_links') %}

<!-- ONA Floating Glass Header -->
<header class="floating-header mt-4 mb-8 glass-panel border border-white/20 shadow-ambient px-6 md:px-10 h-20 flex justify-between items-center z-50 transition-all duration-300">
    <div class="flex items-center gap-6">
        <!-- Mobile Menu Toggle -->
        <a class="lg:hidden mburger mburger--collapse leading-none text-ona-primary" href="#mobile-menu" aria-label="Open-menu">
            <i class="sicon-menu text-2xl"></i>
        </a>
        
        <!-- Brand Logo -->
        <a class="navbar-brand flex items-center gap-2" href="{{ store.url }}">
            {% if store.logo %}
                <img fetchpriority="high" class="h-10 w-auto object-contain" loading="eager" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }} logo">
            {% else %}
                <span class="font-display-2xl text-[32px] font-extrabold text-ona-primary tracking-tighter">{{ store.name }}</span>
            {% endif %}
        </a>
        
        <!-- Desktop Main Menu -->
        <div class="hidden lg:flex items-center gap-8 ml-8">
            <custom-main-menu></custom-main-menu>
        </div>
    </div>
    
    <div class="flex items-center gap-4">
        <!-- Search -->
        <div class="hidden md:block w-64">
            <salla-search inline oval height="40" class="bg-white/50 backdrop-blur-md border border-white/20 rounded-full"></salla-search>
        </div>
        
        <!-- Localization (Lang/Currency) -->
        {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
            <div class="hidden sm:block">
                <salla-localization-modal show-trigger></salla-localization-modal>
            </div>
        {% endif %}
        
        <!-- User Menu -->
        <div class="hover:scale-105 transition-transform duration-300">
            <salla-user-menu avatar-only show-header show-trigger></salla-user-menu>
        </div>
        
        <!-- Cart Summary -->
        <div class="hover:scale-105 transition-transform duration-300 relative group">
            <salla-cart-summary class="text-ona-primary hover:text-ona-accent transition-colors">
                <i slot="icon" class="sicon-shopping-bag text-2xl"></i>
            </salla-cart-summary>
        </div>
    </div>
</header>
