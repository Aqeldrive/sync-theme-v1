{# AR Try-On Component #}
<section class="ona-ar-try-on container mx-auto px-4 my-16 neural-section" style="border-radius: 2rem; padding: 2rem 1rem; border: 1px solid var(--border-color, #e5e7eb);">
    <div class="glass-panel border-t border-white/20 backdrop-blur-2xl rounded-t-[3rem] pt-8 pb-8 px-6 md:px-12 bg-white/50 shadow-ambient">
        <div class="container mx-auto max-w-[1600px]">
            
            {% if component.fields.title %}
                <h2 class="{{ theme.settings.typography.heading_size }} font-bold mb-4"
                    style="color: {{ theme.settings.colors.primary }}; font-family: '{{ theme.settings.typography.font_family }}', sans-serif;">
                    {{ component.fields.title }}
                </h2>
            {% endif %}
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- AR Product Viewer -->
                <div>
                    <h3>{{ trans('products.details') }}</h3>
                    <p class="text-gray-600 mb-4">
                        {{ trans('ar.try_on_description') | default('Visualize products in your space using augmented reality') }}
                    </p>
                    <div id="ar-viewer" class="rounded-[2rem] h-[400px] bg-sync-surface border border-sync-glass-border overflow-hidden"
                         style="background: var(--sync-surface); min-height: 400px;">
                        <div class="absolute inset-0">
                            {{ component.fields.ar_image | default('https://images.unsplash.com/photo-1502596123810-c96a6a5e119e?w=800&q=80') }}
                        </div>
                    </div>
                    <p class="text-center text-sm mt-3">
                        <salla-button color="primary" class="px-4 py-1">
                            {{ trans('ar.try_now') | default('Try AR') }}
                        </salla-button>
                    </p>
                </div>
                
                <!-- Product Info -->
                <div>
                    <h3>{{ trans('product.details') }}</h3>
                    <div class="space-y-3">
                        <div class="flex justify-between">
                            <span>{{ trans('product.name') }}</span>
                            <span class="font-bold">{{ component.fields.product_name | default('Product') }}</span>
                        </div>
                        <div class="flex justify-between">
                            <span>{{ trans('product.price') }}</span>
                            <span class="font-bold {{ 'text-sync-primary' }}" style="color: {{ theme.settings.colors.primary }};">
                                {{ component.fields.price | default('0') }} {{ trans('currency') }}
                            </span>
                        </div>
                        <div class="flex justify-between">
                            <span>{{ trans('product.rating') }}</span>
                            <div class="flex">
                                {% for i in 1..5 %}
                                    <span class="material-symbols-outlined text-sm {{ 'text-sync-secondary' }}">star</span>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</section>