<section class="container mx-auto px-4 md:px-8 xl:px-0 py-10 md:py-14 text-center relative z-10">
    <div class="glass-panel rounded-[32px] p-8 md:p-10 bg-white/70">
        {% if component.fields.title %}
            <h2 class="font-display text-[26px] md:text-[32px] font-extrabold tracking-[-0.03em] text-ink mb-3">{{ component.fields.title }}</h2>
            <div class="w-12 h-1 bg-lime rounded-full mx-auto shadow-glow"></div>
        {% endif %}
        {% if component.fields.description %}<p class="text-[14px] leading-6 text-gray-500 mt-4 max-w-xl mx-auto">{{ component.fields.description }}</p>{% endif %}
        
        <div class="flex justify-center gap-3 md:gap-4 mt-8 text-ink" data-countdown="{{ component.fields.end_date }}">
            {% set units = [['days','يوم'],['hours','ساعة'],['minutes','دقيقة'],['seconds','ثانية']] %}
            {% for u in units %}
                <div class="flex flex-col items-center bg-white rounded-[16px] border border-outline px-5 md:px-7 py-4 min-w-[72px] md:min-w-[84px] shadow-sm">
                    <span class="{{ u[0] }} text-[28px] md:text-[36px] font-extrabold tracking-[-0.03em] text-ink leading-none">00</span>
                    <span class="text-[11px] font-bold tracking-widest uppercase text-gray-400 mt-1.5">{{ u[1] }}</span>
                </div>
                {% if not loop.last %}<span class="text-[20px] font-bold text-gray-300 self-center">:</span>{% endif %}
            {% endfor %}
        </div>
    </div>
</section>
