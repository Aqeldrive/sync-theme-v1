<section class="ona-countdown container mx-auto px-4 my-16 text-center">
    <div class="p-8 rounded-[{{ theme.settings.ui_options.border_radius }}] {% if theme.settings.ui_options.glassmorphism %}glass-panel border border-white/10{% else %}bg-surface-container{% endif %}">
        {% if component.fields.title %}
            <h2 class="{{ theme.settings.typography.heading_size }} font-bold mb-4" 
                style="color: {{ theme.settings.colors.primary }}; font-family: '{{ theme.settings.typography.font_family }}', sans-serif;">
                {{ component.fields.title }}
            </h2>
        {% endif %}
        <p class="mb-8" style="color: {{ theme.settings.colors.text_color }};">{{ component.fields.description }}</p>
        
        <div class="flex justify-center gap-4 text-2xl md:text-4xl font-bold" style="color: {{ theme.settings.colors.secondary }};" data-countdown="{{ component.fields.end_date }}">
            <div class="flex flex-col items-center">
                <span class="days">00</span>
                <span class="text-xs mt-1" style="color: {{ theme.settings.colors.text_color }};">يوم</span>
            </div>
            <span>:</span>
            <div class="flex flex-col items-center">
                <span class="hours">00</span>
                <span class="text-xs mt-1" style="color: {{ theme.settings.colors.text_color }};">ساعة</span>
            </div>
            <span>:</span>
            <div class="flex flex-col items-center">
                <span class="minutes">00</span>
                <span class="text-xs mt-1" style="color: {{ theme.settings.colors.text_color }};">دقيقة</span>
            </div>
            <span>:</span>
            <div class="flex flex-col items-center">
                <span class="seconds">00</span>
                <span class="text-xs mt-1" style="color: {{ theme.settings.colors.text_color }};">ثانية</span>
            </div>
        </div>
    </div>
</section>
