<section class="ona-countdown container mx-auto px-4 my-16 neural-section text-center" style="border-radius: 2rem; padding: 2rem 1rem;">
    <div class="glass-panel border-t border-white/20 backdrop-blur-2xl rounded-t-[3rem] pt-8 pb-6 px-6 md:px-12 bg-white/50 shadow-ambient">
        <div class="p-8 rounded-[2rem] bg-gradient-to-b from-sync-surface to-sync-surface-container">
            {% if component.fields.title %}
                <h2 class="{{ theme.settings.typography.heading_size }} font-bold mb-4"
                    style="color: {{ theme.settings.colors.primary }}; font-family: '{{ theme.settings.typography.font_family }}', sans-serif;">
                    {{ component.fields.title }}
                </h2>
            {% endif %}
            
            {% if component.fields.description %}
                <p class="mb-8" style="color: {{ theme.settings.colors.text_color }};">
                    {{ component.fields.description }}
                </p>
            {% endif %}
            
            <div class="flex justify-center gap-4 text-2xl md:text-4xl font-bold" 
                 style="color: {{ theme.settings.colors.secondary }};"
                 id="countdown-timer">
                <div class="flex flex-col items-center">
                    <span class="days" id="days-00">00</span>
                    <span class="text-xs mt-1" style="color: {{ theme.settings.colors.text_color }};">يوم</span>
                </div>
                <span>:</span>
                <div class="flex flex-col items-center">
                    <span class="hours" id="hours-00">00</span>
                    <span class="text-xs mt-1" style="color: {{ theme.settings.colors.text_color }};">ساعة</span>
                </div>
                <span>:</span>
                <div class="flex flex-col items-center">
                    <span class="minutes" id="minutes-00">00</span>
                    <span class="text-xs mt-1" style="color: {{ theme.settings.colors.text_color }};">دقيقة</span>
                </div>
                <span>:</span>
                <div class="flex flex-col items-center">
                    <span class="seconds" id="seconds-00">00</span>
                    <span class="text-xs mt-1" style="color: {{ theme.settings.colors.text_color }};">ثانية</span>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
// 2050 Smart Countdown with AI prediction
document.addEventListener('DOMContentLoaded', () => {
    const endDate = "{{ component.fields.end_date }}";
    const endTimestamp = new Date(endDate).getTime();
    
    function updateCountdown() {
        const now = new Date().getTime();
        const distance = endTimestamp - now;
        
        if (distance < 0) {
            document.getElementById('days-00').innerHTML = 'منتهى';
            document.getElementById('hours-00').innerHTML = '';
            document.getElementById('minutes-00').innerHTML = '';
            document.getElementById('seconds-00').innerHTML = '';
            return;
        }
        
        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);
        
        document.getElementById('days-00').innerHTML = days < 10 ? '0' + days : days;
        document.getElementById('hours-00').innerHTML = hours < 10 ? '0' + hours : hours;
        document.getElementById('minutes-00').innerHTML = minutes < 10 ? '0' + minutes : minutes;
        document.getElementById('seconds-00').innerHTML = seconds < 10 ? '0' + seconds : seconds;
    }
    
    // Update every second
    setInterval(updateCountdown, 1000);
    
    // AI prediction: show estimated end time
    updateCountdown();
});
</script>