<section class="max-w-[1280px] mx-auto px-4 md:px-8 xl:px-0 w-full py-10 md:py-14 relative z-10">
    {% if component.fields.title %}
        <div class="mb-8 md:mb-10 flex flex-col md:flex-row justify-between items-start md:items-end gap-4 border-b border-outline pb-6">
            <div>
                <h2 class="font-display text-[26px] md:text-[32px] font-extrabold tracking-[-0.03em] text-ink leading-none">{{ component.fields.title }}</h2>
                <div class="w-12 h-1 bg-lime rounded-full mt-3"></div>
            </div>
            {% if component.fields.description %}
                <p class="text-[14px] leading-6 text-gray-500 max-w-md">{{ component.fields.description }}</p>
            {% else %}
                <p class="text-[14px] leading-6 text-gray-500 max-w-md hidden md:block">اكتشف تشكيلتنا المختارة بعناية.</p>
            {% endif %}
        </div>
    {% endif %}

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
        {% for product in component.fields.products %}
            <div class="group relative flex flex-col bg-white rounded-[24px] border border-outline p-3 md:p-4 hover:border-lime/40 hover:shadow-elevated hover:-translate-y-1 transition-all duration-300 ease-atelier h-full">
                
                <div class="relative aspect-square overflow-hidden rounded-[16px] bg-paper-container">
                    {% if product.image.url %}
                        <img src="{{ product.image.url }}" alt="{{ product.image.alt|default(product.name) }}" class="w-full h-full object-cover transition-transform duration-[600ms] ease-atelier group-hover:scale-[1.04]" loading="lazy">
                    {% else %}
                        <img src="{{ 'images/placeholder.png'|asset }}" alt="{{ product.name }}" class="w-full h-full object-cover opacity-50">
                    {% endif %}
                    
                    <salla-button type="favorite" product-id="{{ product.id }}" class="absolute top-2.5 left-2.5 w-9 h-9 bg-white/90 backdrop-blur-md border border-white/70 rounded-full flex items-center justify-center text-ink hover:text-red-600 hover:bg-white shadow-sm transition-all">
                        <i class="sicon-heart text-[16px]"></i>
                    </salla-button>
                    {% if product.is_new %}
                        <span class="absolute top-2.5 right-2.5 bg-lime text-ink text-[10px] font-bold tracking-widest uppercase px-2.5 py-1 rounded-full">جديد</span>
                    {% endif %}
                </div>
                
                <div class="flex flex-col flex-grow pt-3">
                    <h3 class="text-[14px] font-bold leading-snug text-ink line-clamp-2 group-hover:text-forest transition-colors min-h-[40px]">
                        <a href="{{ product.url }}">{{ product.name }}</a>
                    </h3>
                    
                    <div class="mt-auto flex items-center justify-between pt-3 border-t border-outline/60">
                        <div class="flex flex-col">
                            {% if product.has_special_price %}
                                <span class="text-[16px] font-extrabold tracking-[-0.02em] text-forest leading-none">{{ product.price|money }}</span>
                                <span class="text-[11px] text-gray-400 line-through">{{ product.regular_price|money }}</span>
                            {% else %}
                                <span class="text-[16px] font-extrabold tracking-[-0.02em] text-ink leading-none">{{ product.price|money }}</span>
                            {% endif %}
                        </div>
                        
                        <salla-add-product-button product-id="{{ product.id }}" class="w-9 h-9 rounded-full bg-ink text-white flex items-center justify-center hover:bg-ink-hover hover:shadow-glow transition-all">
                            <i class="sicon-add text-[18px]"></i>
                        </salla-add-product-button>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-span-full text-center py-16 bg-white rounded-[24px] border border-dashed border-outline">
                <p class="text-[14px] font-semibold text-gray-500">لا توجد منتجات — اختر من محرر الثيم</p>
            </div>
        {% endfor %}
    </div>
</section>
