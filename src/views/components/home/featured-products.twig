<section class="container mx-auto px-4 md:px-8 xl:px-0 py-10 md:py-14 relative z-10">
    {% if component.fields.title %}
        <div class="mb-8 md:mb-10 flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-outline/60 pb-6">
            <div>
                <h2 class="font-display text-[28px] md:text-[36px] font-extrabold tracking-[-0.03em] text-ink leading-none">{{ component.fields.title }}</h2>
                <div class="w-12 h-1 bg-lime rounded-full mt-3 shadow-glow"></div>
            </div>
            <p class="text-[14px] leading-6 text-gray-500 max-w-md hidden md:block">مختارات بعناية — كل قطعة تروي قصة.</p>
        </div>
    {% endif %}

    {# ——— FIX #4: If merchant hasn't selected products, auto-show latest products so page is NEVER empty ——— #}
    {% if component.fields.products|length %}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
            {% for product in component.fields.products %}
                <div class="product-card-atelier group flex flex-col bg-white p-4 md:p-5">
                    <div class="relative aspect-[4/5] overflow-hidden rounded-[24px] bg-paper-container">
                        {% if product.image.url %}
                            <img src="{{ product.image.url }}" alt="{{ product.image.alt|default(product.name) }}" class="thumb-zoom w-full h-full object-cover" loading="lazy">
                        {% else %}
                            <img src="{{ 'images/placeholder.png'|asset }}" alt="{{ product.name }}" class="w-full h-full object-cover opacity-50">
                        {% endif %}
                        <div class="scrim absolute inset-0 pointer-events-none"></div>
                        
                        {% if product.is_new %}
                            <div class="absolute top-3.5 right-3.5 bg-lime text-ink text-[11px] font-bold tracking-[0.06em] uppercase px-3.5 py-1.5 rounded-full shadow-glow">جديد</div>
                        {% endif %}
                        {% if product.has_special_price %}
                            <div class="absolute top-3.5 {% if product.is_new %}right-[88px]{% else %}right-3.5{% endif %} bg-ink text-white text-[11px] font-bold px-3 py-1.5 rounded-full">خصم</div>
                        {% endif %}
                        
                        <salla-button type="favorite" product-id="{{ product.id }}" class="absolute top-3.5 left-3.5 w-10 h-10 bg-white/90 backdrop-blur-md rounded-full flex items-center justify-center text-ink hover:text-red-600 hover:bg-white border border-white/60 shadow-sm hover:scale-105 transition-all">
                            <i class="sicon-heart text-[18px]"></i>
                        </salla-button>
                        
                        <div class="absolute bottom-4 left-1/2 -translate-x-1/2 w-[88%] translate-y-3 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-400 ease-atelier">
                            <salla-add-product-button product-id="{{ product.id }}" class="w-full">
                                <span class="btn-atelier-primary w-full text-white">
                                    إضافة للسلة <i class="sicon-shopping-bag text-[16px] opacity-80"></i>
                                </span>
                            </salla-add-product-button>
                        </div>
                    </div>
                    
                    <div class="px-1 pt-4 flex flex-col flex-1">
                        <h3 class="text-[16px] font-bold leading-snug text-ink line-clamp-1 group-hover:text-forest transition-colors">
                            <a href="{{ product.url }}">{{ product.name }}</a>
                        </h3>
                        {% if product.subtitle %}<p class="text-[13px] leading-5 text-gray-500 line-clamp-1 mt-1">{{ product.subtitle }}</p>{% endif %}
                        <div class="mt-3 flex items-end justify-between">
                            <div class="flex flex-col">
                                {% if product.has_special_price %}
                                    <span class="text-[20px] font-extrabold tracking-[-0.02em] text-forest leading-none">{{ product.price|money }}</span>
                                    <span class="text-[12px] text-gray-400 line-through mt-0.5">{{ product.regular_price|money }}</span>
                                {% else %}
                                    <span class="text-[20px] font-extrabold tracking-[-0.02em] text-ink leading-none">{{ product.price|money }}</span>
                                {% endif %}
                            </div>
                            {% if product.rating %}
                                <div class="flex items-center gap-1.5 bg-paper border border-outline px-2.5 py-1 rounded-full">
                                    <i class="sicon-star text-yellow-500 text-[11px]"></i>
                                    <span class="text-[12px] font-bold text-ink">{{ product.rating }}</span>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        {# — AUTO FALLBACK: show latest products automatically so homepage is never empty — #}
        <salla-products-slider source="latest" limit="6" class="featured-auto-fallback"></salla-products-slider>
        <p class="text-center text-[12px] text-gray-400 mt-4">يعرض أحدث المنتجات تلقائياً — يمكنك تخصيص المنتجات من محرر الثيم</p>
    {% endif %}
</section>
