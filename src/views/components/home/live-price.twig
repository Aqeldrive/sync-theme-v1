{# Live Price Updates Component #}
<section class="ona-live-price container mx-auto px-4 my-16 neural-section" style="border-radius: 2rem; padding: 2rem 1rem;">
    <div class="glass-panel border-t border-white/20 backdrop-blur-2xl rounded-t-[3rem] pt-8 pb-8 px-6 md:px-12 bg-white/50 shadow-ambient">
        <div class="container mx-auto max-w-[1600px]">
            
            {% if component.fields.title %}
                <h2 class="{{ theme.settings.typography.heading_size }} font-bold mb-4"
                    style="color: {{ theme.settings.colors.primary }}; font-family: '{{ theme.settings.typography.font_family }}', sans-serif;">
                    {{ component.fields.title }}
                </h2>
            {% endif %}
            
            <div class="space-y-4">
                <!-- Price History Chart -->
                <div>
                    <h3>{{ trans('price.history') }}</h3>
                    <div class="relative h-[200px] bg-sync-surface border border-sync-glass-border rounded-[1.5rem] overflow-hidden">
                        <canvas id="price-chart" class="w-full h-full"></canvas>
                    </div>
                    <p class="text-xs text-gray-500 text-center mt-2">
                        {{ trans('price.last_updated') | default('Just now') }}
                    </p>
                </div>
                
                <!-- Current Price -->
                <div>
                    <h3>{{ trans('current.price') }}</h3>
                    <div class="flex items-center gap-4">
                        <div class="text-3xl {{ 'font-bold' }} {{ 'text-sync-primary' }}" style="color: {{ theme.settings.colors.primary }};">
                            {{ component.fields.current_price | default('0.00') }}
                        </div>
                        <div class="text-sm text-gray-500">
                            {{ trans('currency') }}
                        </div>
                    </div>
                    <p class="text-sm mt-1">
                        {{ trans('inclusive_tax') | default('Tax included') }}
                    </p>
                </div>
                
                <!-- Price Trend -->
                <div>
                    <h3>{{ trans('price.trend') }}</h3>
                    <div class="flex items-center gap-2">
                        {% if component.fields.price_trend == 'increasing' %}
                            <span class="{{ 'text-sync-secondary' }} text-uppercase">{{ trans('price.rising') | default('Price rising') }}</span>
                        {% elif component.fields.price_trend == 'decreasing' %}
                            <span class="{{ 'text-sync-success' }} text-uppercase">{{ trans('price.falling') | default('Price falling') }}</span>
                        {% else %}
                            <span class="{{ 'text-gray-500' }} text-uppercase">{{ trans('price.stable') | default('Price stable') }}</span>
                        {% endif %}
                    </div>
                    <div class="mt-2">
                        {{ component.fields.percent_change | default('0%') }}
                    </div>
                </div>
            </div>
            
            {% if component.fields.show_cta %}
                <div class="mt-6 text-center">
                    <salla-button color="primary" class="px-6 py-2">
                        {{ trans('historical.price.view_history') | default('View Price History') }}
                    </salla-button>
                </div>
            {% endif %}
            
        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Simple price chart simulation
    const ctx = document.getElementById('price-chart').getContext('2d');
    const chart = new ctx.Chart('price-chart', {
        type: 'line',
        data: {
            labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
            datasets: [{
                label: 'Price',
                data: [{{ component.fields.price_data | default('[100, 120, 130, 110, 140, 150]') }},
                borderColor: 'var(--sync-primary)',
                backgroundColor: 'rgba(0, 23, 59, 0.1)',
                tension: 0.4,
                fill: true
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false
        }
    });
});
</script>