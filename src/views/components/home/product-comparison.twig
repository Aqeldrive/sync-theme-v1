<section class="ona-product-comparison container mx-auto px-4 my-16 overflow-x-auto">
    {% if component.fields.title %}
        <div class="text-center mb-10">
            <h2 class="{{ theme.settings.typography.heading_size }} font-bold" 
                style="color: {{ theme.settings.colors.primary }}; font-family: '{{ theme.settings.typography.font_family }}', sans-serif;">
                {{ component.fields.title }}
            </h2>
        </div>
    {% endif %}
    
    <table class="w-full text-center border-collapse min-w-[600px]">
        <thead>
            <tr>
                <th class="p-4 border-b border-white/10"></th>
                {% for product in component.fields.products %}
                    <th class="p-4 border-b border-white/10 w-1/3">
                        <img src="{{ product.image.url }}" class="w-32 h-32 object-cover mx-auto rounded-lg mb-4">
                        <h3 class="font-bold text-lg" style="color: {{ theme.settings.colors.primary }};">{{ product.name }}</h3>
                        <span class="font-bold block mt-2" style="color: {{ theme.settings.colors.secondary }};">{{ product.price }} {{ trans('blocks.home.currency') }}</span>
                    </th>
                {% endfor %}
            </tr>
        </thead>
        <tbody style="color: {{ theme.settings.colors.text_color }};">
            {% for feature in component.fields.features %}
                <tr class="{% if loop.index % 2 == 0 %}bg-white/5{% endif %}">
                    <td class="p-4 font-bold border-b border-white/5">{{ feature.name }}</td>
                    <td class="p-4 border-b border-white/5">{{ feature.value_1 }}</td>
                    <td class="p-4 border-b border-white/5">{{ feature.value_2 }}</td>
                    <td class="p-4 border-b border-white/5">{{ feature.value_3 }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</section>
