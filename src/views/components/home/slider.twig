{% if component.fields.slides|length %}
<section class="reveal" class="home-slider container mx-auto px-4 md:px-6 xl:px-0 mt-4 md:mt-6 mb-8 md:mb-12 z-10 relative">
    <salla-slider type="carousel" controls="outer" class="rounded-[24px] md:rounded-[32px] overflow-hidden shadow-ambient">
        <div slot="items">
            {% for slide in component.fields.slides %}
                <div class="relative w-full h-[520px] md:h-[640px] flex items-center justify-center overflow-hidden group">
                    <img src="{{ slide['slides.image'] }}" alt="{{ slide['slides.title'] }}" class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1200ms] ease-atelier group-hover:scale-[1.03]" loading="{{ loop.first ? 'eager' : 'lazy' }}" fetchpriority="{{ loop.first ? 'high' : 'auto' }}">
                    
                    <div class="absolute inset-0 bg-gradient-to-t from-ink/75 via-ink/25 to-transparent"></div>
                    
                    <div class="relative z-10 max-w-[640px] text-center space-y-5 p-6 md:p-10 mx-4">
                        
                        {% if slide['slides.title'] %}
                            <h2 class="font-display text-[32px] md:text-[44px] font-extrabold tracking-[-0.04em] leading-[0.95] text-white">
                                {{ slide['slides.title'] }}
                            </h2>
                        {% endif %}
                        
                        {% if slide['slides.description'] %}
                            <p class="text-[15px] md:text-[17px] leading-7 text-white/85 max-w-[520px] mx-auto font-medium">
                                {{ slide['slides.description'] }}
                            </p>
                        {% endif %}
                        
                        {% if slide['slides.button_text'] %}
                            <div class="pt-3">
                                <a href="{{ slide['slides.button_url'] }}" class="inline-flex items-center gap-2 bg-lime text-ink text-[14px] font-bold tracking-[-0.01em] px-8 py-3.5 rounded-full hover:bg-lime-hover hover:shadow-glow hover:-translate-y-0.5 transition-all duration-200 ease-atelier">
                                    {{ slide['slides.button_text'] }} <i class="sicon-arrow-left text-[14px]"></i>
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </salla-slider>
</section>
{% endif %}
