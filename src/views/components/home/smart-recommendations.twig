{# Smart Recommendations Component #}
<section class="ona-smart-recommendations container mx-auto px-4 my-16 neural-section" style="border-radius: 2rem; padding: 2rem 1rem;">
    <div class="glass-panel border-t border-white/20 backdrop-blur-2xl rounded-t-[3rem] pt-8 pb-8 px-6 md:px-12 bg-white/50 shadow-ambient">
        <div class="container mx-auto max-w-[1600px]">
            
            {% if component.fields.title %}
                <h2 class="{{ theme.settings.typography.heading_size }} font-bold mb-4"
                    style="color: {{ theme.settings.colors.primary }}; font-family: '{{ theme.settings.typography.font_family }}', sans-serif;">
                    {{ component.fields.title }}
                </h2>
            {% endif %}
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {% for product in component.fields.products %}
                    <div class="group relative p-4 rounded-[2rem] bg-sync-surface/50 border border-sync-glass-border hover:scale-105 transition-transform hover:border-sync-accent"
                        style="transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);">
                        <a href="{{ product.url }}" class="block">
                            <img src="{{ product.image.url }}" alt="{{ product.name }}" class="w-full h-40 object-cover rounded-[1.5rem] mb-3 group-hover:opacity-90 transition-opacity">
                            <h3 class="font-bold text-[16px] {{ 'text-sync-primary' }} line-clamp-1">{{ product.name }}</h3>
                            <div class="flex items-center gap-2 mt-2">
                                {% for i in 1..product.rating.value %}
                                    <span class="material-symbols-outlined text-sm text-sync-secondary">star</span>
                                {% endfor %}
                                <span class="text-xs {{ 'text-gray-500' }}">{{ product.rating.count }}</span>
                            </div>
                            <span class="font-medium {{ 'text-sync-primary' }}" style="color: {{ theme.settings.colors.primary }};">
                                {{ product.price|money }}
                            </span>
                        </a>
                    </div>
                {% endfor %}
            </div>
            
            {% if component.fields.see_more %}
                <div class="mt-6 text-center">
                    <salla-button color="primary" class="px-6 py-2">
                        {{ trans('common.elements.view_more') }}
                    </salla-button>
                </div>
            {% endif %}
            
        </div>
    </div>
</section>