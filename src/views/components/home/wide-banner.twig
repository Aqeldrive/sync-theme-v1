<section class="ona-wide-banner container mx-auto px-4 my-12 relative overflow-hidden rounded-[{{ theme.settings.ui_options.border_radius }}]">
    <a href="{{ component.fields.url }}" class="block w-full h-auto group">
        <div class="relative w-full aspect-[21/9] md:aspect-[32/9] overflow-hidden">
            <img src="{{ component.fields.image.url }}" alt="Banner" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
            <div class="absolute inset-0 bg-black/20 group-hover:bg-black/0 transition-colors duration-300"></div>
        </div>
    </a>
</section>
