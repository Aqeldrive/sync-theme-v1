{#| Variable         | Type    | Description                     |
||------------------|---------|---------------------------------|
|| cart             | object  |                                 |
|| cart.items_count | int     |                                 |
|| cart.total       | string  | Formatted total ex: "100 ر.س"   |#}
<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<!-- بسم الله الرحمن الرحيم -->
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ theme.settings.set('placeholder', 'images/placeholder.png') }}
    
    <!-- 2050 ONA Smart Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM%20Plex%20Sans%20Arabic:wght@400;500;600;700;800&family=Plus%20Jakarta%20Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap&subset=arabic&display=swap" rel="stylesheet">
    
    <script defer data-cfasync="false" crossorigin="anonymous" src="{{ 'product-card.js'|asset }}"></script>
    <script defer src="{{ 'main-menu.js'|asset }}"></script>
    {% if theme.settings.get('enable_add_product_toast', true) %}
        <script defer src="{{ 'add-product-toast.js'|asset }}"></script>
    {% endif %}
    {% block head_scripts %}{% endblock %}
    <script data-cfasync="false">
        window.header_is_sticky = "{{theme.settings.get('header_is_sticky', 'Default Value')}}"
        window.imageZoom = "{{theme.settings.get('imageZoom')}}"
        window.can_access_wallet = {{ user.can_access_wallet | json_encode }}
        window.enable_more_menu = "{{ theme.settings.get('enable_more_menu', true) }}"
        window.enable_add_product_toast = "{{ theme.settings.get('enable_add_product_toast', true) }}"
        window.notify_when_available_in_card = "{{ theme.settings.get('notify_when_available_in_card', true) }}"
        window.smart_recommendations_enabled = "{{ theme.settings.get('ai_recommendations', true) }}"
        window.ar_try_on_enabled = "{{ theme.settings.get('ar_try_on', true) }}"
        window.crypto_payment_enabled = "{{ theme.settings.get('crypto_payment', false) }}"
        window.live_shopping_enabled = "{{ theme.settings.get('live_shopping', false) }}"
        window.dynamic_pricing_enabled = "{{ theme.settings.get('dynamic_pricing', false) }}"
    </script>
    
    {% hook 'head:start' %}
    {% hook head %}
    {% block styles %}{% endblock %}
    <link rel="stylesheet" href="{{ 'app.css' | asset }}">
    <link rel="stylesheet" href="{{ theme.font.path|cdn }}">
    <link rel="stylesheet" href="{{ 'fonts/sallaicons.css'|cdn }}">
    
    <style>
        :root {
            --font-main: 'IBM Plex Sans Arabic', 'Plus Jakarta Sans', 'Inter', sans-serif;
            --color-primary: {{ theme.color.primary }};
            --color-primary-dark: {{ theme.color.darker(0.15) }};
            --color-primary-light: {{ theme.color.lighter(0.15) }};
            --color-primary-reverse: {{ theme.color.reverse_text }};
            --color-secondary: {{ theme.color.secondary }};
            --color-accent: {{ theme.color.accent }};
            --color-background: {{ theme.color.background }};
            --color-surface: {{ theme.color.surface }};
            --color-surface-variant: {{ theme.color.surface_variant }};
            --on-color-primary: {{ theme.color.on_primary }};
            --on-color-surface: {{ theme.color.on_surface }};
        }
    </style>
    
    <!-- 2050 Head Tracking & Attention API -->
    <script>
        // Attention API for immersive shopping
        if ('ongazechange' in window) {
            document.addEventListener('gazechange', (e) => {
                const elements = document.querySelectorAll('.product-card, .feature-item');
                elements.forEach(el => {
                    const rect = el.getBoundingClientRect();
                    const elementCenter = { x: rect.left + rect.width/2, y: rect.top + rect.height/2 };
                    const viewportCenter = { x: window.innerWidth/2, y: window.innerHeight/2 };
                    const distance = Math.sqrt(
                        Math.pow(elementCenter.x - viewportCenter.x, 2) +
                        Math.pow(elementCenter.y - viewportCenter.y, 2)
                    );
                    if (distance < 150) {
                        el.style.boxShadow = '0 0 20px var(--color-primary)';
                    } else {
                        el.style.boxShadow = 'none';
                    }
                });
            });
        }
    </script>
    
    <!-- Neuro-design system for focus enhancement -->
    <script>
        // Reduced motion respect
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('reduced-motion');
        }
    </script>
    
    {% hook 'head:end' %}
</head>
<body id="app" class="theme-sync overflow-x-hidden font-sans bg-sync-surface text-gray-900 selection:bg-sync-accent selection:text-sync-primary {% hook 'body:classes' %}>
{{ theme.settings.get('footer_is_dark') ? ' footer-is-dark' : ' footer-is-light' }}
{{ theme.settings.get('topnav_is_dark') ? ' topnav-is-dark' : '' }}
{{ theme.settings.get('sticky_add_to_cart') ? ' is-sticky-product-bar' : '' }}
{% hook 'body:start' %}

<!-- 2050 Neural Mesh Background -->
<div class="neural-background">
    <div class="mouse-glow" id="glow-element"></div>
    <div class="neural-connection" id="connection-1"></div>
    <div class="neural-connection" id="connection-2"></div>
    <div class="neural-connection" id="connection-3"></div>
</div>

<svg class="neural-svg" width="100%" height="100%" viewBox="0 0 100 100" style="position: fixed; top: 0; left: 0; pointer-events: none; z-index: 0;">
  <g fill="none" stroke="var(--color-primary)" stroke-width="1">
    <line x1="10" y1="10" x2="90" y2="90"/>
    <line x1="10" y1="90" x2="90" y2="10"/>
    <line x1="50" y1="0" x2="50" y2="100"/>
    <line x1="0" y1="50" x2="100" y2="50"/>
  </g>
</svg>

<div class="app-inner flex flex-col min-h-screen relative z-10">
    {% component 'header.header' %}
    
    <main id="main-content" role="main" class="flex-grow w-full px-4 md:px-8 xl:px-0 max-w-[1600px] mx-auto {{ (page.slug == 'product.single' or page.slug starts with 'product.index') ? ' space-y-8 sm:space-y-16' : '' }}">
    {% block content %}{% endblock %}
    </main>
    
    {% component 'footer.footer' %}
</div>

{% hook 'body:end' %}
{% if theme.settings.get('enable_add_product_toast', true) %}
    <salla-add-product-toast></salla-add-product-toast>
{% endif%}
<script defer crossorigin="anonymous" src="{{ 'app.js' | asset }}"></script>
{# Twilight Components #}
<salla-offer-modal></salla-offer-modal>
<salla-search></salla-search>
<salla-login-modal></salla-login-modal>
{% if store.scope %}
    <salla-scopes selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>
{% endif %}
{% block scripts %}{% endblock %}
</body>
</html>