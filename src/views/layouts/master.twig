<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<!-- بسم الله الرحمن الرحيم -->
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ theme.settings.set('placeholder', 'images/placeholder.png') }}
    
    <!-- Atelier High-Level Fonts — Editorial Luxury -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700;800&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script defer data-cfasync="false" crossorigin="anonymous" src="{{ 'product-card.js'|asset }}"></script>
    <script defer src="{{ 'main-menu.js'|asset }}"></script>
    {% if theme.settings.get('enable_add_product_toast', true) %}
        <script defer src="{{ 'add-product-toast.js'|asset }}"></script>
    {% endif %}
    {% block head_scripts %}{% endblock %}
    <script data-cfasync="false">
        window.header_is_sticky = "{{theme.settings.get('header_is_sticky', 'Default Value')}}"
        window.imageZoom = "{{theme.settings.get('imageZoom')}}"
        window.can_access_wallet = {{ user.can_access_wallet | json_encode }}
        window.enable_more_menu = "{{ theme.settings.get('enable_more_menu', true) }}"
        window.enable_add_product_toast = "{{ theme.settings.get('enable_add_product_toast', true) }}"
        window.notify_when_available_in_card = "{{ theme.settings.get('notify_when_available_in_card', true) }}"
    </script>
    
    {% hook 'head:start' %}
    {% hook head %}
    {% block styles %}{% endblock %}
    <link rel="stylesheet" href="{{ 'app.css' | asset }}">
    <link rel="stylesheet" href="{{ theme.font.path|cdn }}"/>
    <link rel="stylesheet" href="{{ 'fonts/sallaicons.css'|cdn }}"/>
    
    <style>
        :root {
            --font-main: 'IBM Plex Sans Arabic', 'Plus Jakarta Sans', sans-serif;
            --font-display: 'Cormorant Garamond', 'IBM Plex Sans Arabic', serif;
            --color-primary: {{ theme.color.primary }};
            --color-primary-dark: {{ theme.color.darker(0.15) }};
            --color-primary-light: {{ theme.color.lighter(0.15) }};
            --color-primary-reverse: {{ theme.color.reverse_text }};
        }
        .font-display{font-family:var(--font-display)}
    </style>
    {# tracking services, custom css feature. #}
    {% hook 'head:end' %}
</head>
{% set _bgRaw = theme.settings.get('background_animation', 'aurora') %}
{% set bg_animation = _bgRaw.value|default(_bgRaw[0].value|default(_bgRaw|default('aurora')))|default('aurora') %}
{% if bg_animation is iterable and bg_animation.value is defined %}{% set bg_animation = bg_animation.value %}{% endif %}
{% if bg_animation is iterable and bg_animation[0] is defined and bg_animation[0].value is defined %}{% set bg_animation = bg_animation[0].value %}{% endif %}
{# Robust fallback — ensure string #}
{% if bg_animation not in ['aurora','silk','cosmic','prism'] %}{% set bg_animation = 'aurora' %}{% endif %}
{% set _glassRaw = theme.settings.get('glass_intensity', 'medium') %}
{% set glass_intensity = _glassRaw.value|default(_glassRaw[0].value|default(_glassRaw|default('medium')))|default('medium') %}
{% if glass_intensity is iterable and glass_intensity.value is defined %}{% set glass_intensity = glass_intensity.value %}{% endif %}
{% set _animRaw = theme.settings.get('animation_intensity', 'balanced') %}
{% set anim_intensity = _animRaw.value|default(_animRaw[0].value|default(_animRaw|default('balanced')))|default('balanced') %}
{% if anim_intensity is iterable and anim_intensity.value is defined %}{% set anim_intensity = anim_intensity.value %}{% endif %}
<body id="app" class="theme-ona overflow-x-hidden font-sans bg-ona-surface text-gray-900 selection:bg-ona-accent selection:text-ona-primary bg-{{ theme.settings.get('enable_background_animation', true) ? bg_animation : 'none' }} glass-{{ glass_intensity }} motion-{{ anim_intensity }} {{ theme.settings.get('enable_animations', true) ? 'animations-on' : 'animations-off' }} {{ theme.settings.get('glassmorphism', true) ? 'glass-on' : 'glass-off' }} {{ theme.settings.get('dark_mode', true) ? 'dark-mode-enabled' : '' }} {{ theme.settings.get('header_is_glassy', true) ? 'header-glass' : 'header-solid' }} {{ theme.settings.get('product_is_glassy', true) ? 'product-glass' : 'product-solid' }} {{ theme.settings.get('cart_is_glassy', false) ? 'cart-glass' : 'cart-solid' }} {{ theme.settings.get('enable_product_glow', true) ? 'glow-on' : 'glow-off' }} {% hook 'body:classes' %}
  {{ theme.settings.get('footer_is_dark') ? ' footer-is-dark' : ' footer-is-light' }}
  {{ theme.settings.get('topnav_is_dark') ? ' topnav-is-dark' : '' }}
  {{ theme.settings.get('sticky_add_to_cart') ? ' is-sticky-product-bar' : '' }}
  {{ theme.settings.get('enable_header_shrink', true) ? ' header-shrink-on' : ' header-shrink-off' }}
  ">
<noscript>
    To get full functionality of this site you need to enable JavaScript. Here is how
    <a href="https://www.enable-javascript.com/" rel="noreferrer"
       target="_blank">To enable JavaScript on webpage</a>.
</noscript>

<!-- ONA Dynamic Mesh Background — controlled by enable_background_animation -->
{% if theme.settings.get('enable_background_animation', true) %}
<div class="mesh-background">
    <div class="mesh-orb orb-a"></div>
    <div class="mesh-orb orb-b"></div>
    <div class="mesh-orb orb-c"></div>
    <div class="mesh-orb orb-d"></div>
    <div class="mouse-glow"></div>
</div>
{% endif %}

<!-- Atelier scroll progress — lime top bar -->
<div class="scroll-progress" aria-hidden="true"><div class="scroll-progress__bar" id="atelier-scroll-bar"></div></div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches || document.body.classList.contains('animations-off');
        const glow = document.querySelector('.mouse-glow');
        if (glow) {
            if (reduce) { glow.style.display='none'; }
            else {
                let ticking=false, mx=0, my=0;
                function updateGlow(){ glow.style.left=mx+'px'; glow.style.top=my+'px'; glow.style.opacity='1'; ticking=false; }
                document.addEventListener('mousemove', e=>{ mx=e.clientX; my=e.clientY; if(!ticking){ requestAnimationFrame(updateGlow); ticking=true; }});
                document.addEventListener('mouseleave', ()=>{ glow.style.opacity='0'; });
            }
        }
        // Header shrink + scroll progress
        const header=document.querySelector('.floating-header');
        const bar=document.getElementById('atelier-scroll-bar');
        let ticking=false;
        const onScroll=()=>{
            if(header){ if(window.scrollY>16) header.classList.add('is-scrolled'); else header.classList.remove('is-scrolled'); }
            if(bar){
                const max=document.documentElement.scrollHeight - window.innerHeight;
                const p=max>0? (window.scrollY/max)*100 : 0;
                bar.style.width=p+'%';
                bar.style.opacity= p>2 ? '1':'0';
            }
            ticking=false;
        };
        window.addEventListener('scroll',()=>{ if(!ticking){ requestAnimationFrame(onScroll); ticking=true; }},{passive:true});
        onScroll();
        // Reveal on scroll — adds .is-visible to .reveal / .reveal-stagger
        if(!reduce && 'IntersectionObserver' in window){
            const obs=new IntersectionObserver((entries)=>{
                entries.forEach(e=>{
                    if(e.isIntersecting){
                        e.target.classList.add('is-visible');
                        obs.unobserve(e.target);
                    }
                });
            },{threshold:0.14, rootMargin:'0px 0px -6% 0px'});
            document.querySelectorAll('.reveal, .reveal-stagger > *, .product-card-atelier, .glass-panel').forEach(el=>{
                // avoid double-observing already visible hero
                if(!el.classList.contains('is-visible')) obs.observe(el);
            });
        } else {
            document.querySelectorAll('.reveal, .reveal-stagger > *').forEach(el=>el.classList.add('is-visible'));
        }
        // CEO: force above-fold visible after 500ms even if observer pending (prevents hidden products)
        setTimeout(()=>{
            document.querySelectorAll('.reveal, .reveal-stagger > *, .product-card-atelier').forEach(el=>{
                const rect = el.getBoundingClientRect();
                if(rect.top < window.innerHeight + 100) el.classList.add('is-visible');
            });
        }, 500);
        // Stagger enhancement — already CSS handles .stagger, but ensure is-visible triggers
        document.querySelectorAll('.stagger').forEach(g=>g.classList.add('reveal-stagger'));
    });
</script>

<div class="app-inner flex flex-col min-h-screen relative z-10">
    {% hook 'body:start' %}
    
    {% component 'header.header' %}
    
    <main id="main-content" role="main" class="flex-grow w-full px-4 md:px-8 xl:px-0 max-w-[1440px] mx-auto {{ (page.slug == 'product.single' or page.slug starts with 'product.index') ? ' space-y-8 sm:space-y-16' : '' }}">
    {% block content %}{% endblock %}
    </main>
    
    {% component 'footer.footer' %}
</div>

{% hook 'body:end' %}
{% if theme.settings.get('enable_add_product_toast', true) %}
    <salla-add-product-toast></salla-add-product-toast>
{% endif %}
<script defer crossorigin="anonymous" src="{{ 'app.js' | asset }}"></script>
{# Twilight Components #}
<salla-offer-modal></salla-offer-modal>
<salla-search></salla-search>
<salla-login-modal></salla-login-modal>
{% if store.scope %}
    <salla-scopes selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>
{% endif %}
{% block scripts %}{% endblock %}
</body>
</html>
