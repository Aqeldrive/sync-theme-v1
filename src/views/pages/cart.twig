{% extends "layouts.master" %}
{% block content %}
    <div class="container relative z-10">
        <nav class="breadcrumbs w-full py-4 bg-white/60 glass-panel backdrop-blur-xl border border-white/20 rounded-[1.5rem] px-5 shadow-ambient mb-6">
            <salla-breadcrumb></salla-breadcrumb>
        </nav>
        
        <h1 class="sr-only">{{ page.title }}</h1>
        <div class="flex flex-col lg:flex-row items-start gap-6 lg:gap-8 pb-24">
            
            <div class="main-content flex-1 w-full bg-white rounded-[32px] border border-outline p-6 md:p-8 shadow-ambient">
                {% hook 'cart:items.start' %}
                
                <div class="flex justify-between items-center mb-6 border-b border-outline/60 pb-5">
                    <div>
                        <h2 class="font-display text-[28px] md:text-[32px] font-bold tracking-[-0.03em] leading-none text-ink">{{ trans('blocks.header.cart') }}</h2>
                        <div class="w-12 h-1 bg-lime rounded-full mt-3 shadow-glow"></div>
                    </div>
                    {% if cart.items|length %}
                        <div class="bg-paper border border-outline px-4 py-2 rounded-full flex items-center gap-2">
                            <span class="text-[13px] text-gray-500">{{ trans('pages.cart.total_items') }}</span>
                            <span class="font-display font-bold text-ink tabular-nums">{{ cart.total_items }}</span>
                        </div>
                    {% endif %}
                </div>

                {% for item in cart.items %}
                    <form onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ item.id }}" class="mb-4 last:mb-0">
                        <section class="cart-item bg-paper rounded-[24px] border border-outline p-5 md:p-6 relative transition-all duration-300 hover:border-lime/30 hover:shadow-ambient">
                            <input type="hidden" name="id" value="{{ item.id }}">
                            
                            <div class="flex gap-4 md:gap-6 items-start">
                                <a href="{{ item.url }}" class="shrink-0 rounded-[16px] overflow-hidden bg-white border border-outline w-24 h-24 md:w-28 md:h-28 block shadow-sm">
                                    <img src="{{ item.thumbnail ? item.thumbnail|cdn(200,200) : 'images/placeholder.png'|asset }}" alt="{{ item.name }}" class="w-full h-full object-cover" loading="lazy" onerror="this.onerror=null;this.src='{{ 'images/placeholder.png'|asset }}'">
                                </a>
                                
                                <div class="flex-1 min-w-0 space-y-2">
                                    <h3 class="font-display text-[16px] md:text-[17px] text-ink font-bold leading-tight line-clamp-2">
                                        <a href="{{ item.url }}" class="hover:text-forest transition-colors">{{ item.name }}</a>
                                    </h3>
                                    
                                    {% if item.weight %}
                                        <p class="text-[13px] text-gray-500">{{ item.weight }}</p>
                                    {% endif %}
                                    
                                    {% if item.offer_name %}
                                        <div class="inline-flex items-center gap-1.5 bg-lime/15 text-ink border border-lime/20 px-3 py-1 rounded-full">
                                            <i class="sicon-discount-calculator text-[14px]"></i>
                                            <span class="text-[12px] font-bold">{{ item.offer_name }}</span>
                                        </div>
                                    {% endif %}

                                    <div class="flex flex-wrap items-center gap-2 pt-1">
                                        <span class="font-display text-[15px] text-ink font-bold tabular-nums">
                                            {{ item.is_available ? item.product_price|money : trans('pages.cart.out_of_stock') }}
                                        </span>
                                        <span class="text-gray-300">·</span>
                                        {% if item.is_hidden_quantity %}
                                            <span class="text-[13px] font-bold text-gray-600 bg-white border border-outline px-3 py-1 rounded-full">{{ item.quantity }} ×</span>
                                        {% else %}
                                            <div class="flex items-center bg-white border border-outline rounded-full px-1 h-[36px]">
                                                <salla-quantity-input cart-item-id="{{ item.id }}" max="{{ item.max_quantity }}" value="{{ item.quantity }}" name="quantity" class="bg-transparent"></salla-quantity-input>
                                            </div>
                                        {% endif %}
                                    </div>
                                    
                                    <salla-cart-item-offers quantity="{{ item.quantity }}" item-id="{{ item.id }}" product-price="{{ item.product_price }}" offers="{{ item.detailed_offers|json_encode }}"></salla-cart-item-offers>
                                    {% include 'pages.partials.product.options' with {product:item} %}
                                </div>
                                
                                <div class="hidden md:flex flex-col items-end gap-2 shrink-0">
                                    {% set item_total = item.detailed_offers|length > 0 ? item.total_special_price|money : item.total|money %}
                                    <span class="text-[11px] tracking-[0.08em] font-bold text-gray-400 uppercase">{{ trans('pages.cart.total') }}</span>
                                    <span class="font-display text-[18px] md:text-[20px] text-ink font-bold tabular-nums">{{ item.is_available ? item_total : trans('pages.cart.out_of_stock') }}</span>
                                    <salla-button type="button" shape="icon" size="small" class="w-8 h-8 rounded-full bg-white border border-outline text-gray-400 hover:text-danger hover:border-danger/20 transition-colors flex items-center justify-center mt-2" aria-label="Remove" onclick="salla.cart.deleteItem('{{ item.id }}').then(() => document.querySelector('#item-{{ item.id }}').remove())">
                                        <i class="sicon-trash text-[14px]"></i>
                                    </salla-button>
                                </div>
                            </div>
                            
                            <div class="md:hidden flex justify-between items-center mt-4 pt-4 border-t border-outline/60">
                                {% set item_total = item.detailed_offers|length > 0 ? item.total_special_price|money : item.total|money %}
                                <span class="font-display text-[18px] text-ink font-bold tabular-nums">{{ item.is_available ? item_total : trans('pages.cart.out_of_stock') }}</span>
                                <salla-button type="button" shape="icon" size="small" class="w-8 h-8 rounded-full bg-white border border-outline text-gray-400 flex items-center justify-center" aria-label="Remove" onclick="salla.cart.deleteItem('{{ item.id }}').then(() => document.querySelector('#item-{{ item.id }}').remove())">
                                    <i class="sicon-trash text-[14px]"></i>
                                </salla-button>
                            </div>
                        </section>
                    </form>
                {% else %}
                    <div class="flex flex-col items-center justify-center py-16 px-4 text-center">
                        <div class="w-28 h-28 rounded-full bg-paper border border-outline flex items-center justify-center mb-6">
                            <i class="sicon-shopping-bag text-ink/20 text-[48px]"></i>
                        </div>
                        <p class="font-display text-[20px] font-bold text-ink mb-2">{{ trans('pages.cart.empty_cart') }}</p>
                        <p class="text-[13px] text-gray-500 mb-6 max-w-[360px]">ابدأ التسوق واكتشف تشكيلتنا المختارة — منتجات مختارة بعناية.</p>
                        <a href="{{ link('/') }}" class="btn-atelier-lime px-8 py-3 rounded-full font-bold text-[14px] shadow-glow">{{ trans('common.elements.back_home') }}</a>
                    </div>
                {% endfor %}
                
                {% if cart.options|length %}
                  <div class="cart-options mt-6 border-t border-outline/60 pt-6">
                    {% for product_option in cart.options %}
                      <form class="mb-4 bg-paper rounded-[24px] p-5 border border-outline" onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ product_option.id }}">
                        <input type="hidden" name="id" value="{{ product_option.id }}">
                        <input type="hidden" name="quantity" value="{{ product_option.quantity }}">
                        {% include 'pages.partials.product.options' with { product: product_option } %}
                      </form>
                    {% endfor %}
                  </div>
                {% endif %}
                
                <salla-offer></salla-offer>
                {% hook 'cart:items.end' %}
            </div>
            
            {% hook 'cart:summary.start' %}
            
            {% if cart.items|length %}
                <div class="w-full lg:w-[380px] lg:sticky lg:top-24 space-y-4">
                    
                    <div class="bg-paper rounded-[24px] border border-outline p-5 {{ cart.free_shipping_bar ? '' : 'hidden' }}" id="free-shipping">
                        <div class="flex gap-3 items-center">
                            <div class="w-10 h-10 rounded-full bg-white border border-outline flex items-center justify-center text-ink shrink-0">
                                <i class="sicon-shipping-fast text-[16px]"></i>
                            </div>
                            {% set is_free=cart.free_shipping_bar.has_free_shipping %}
                            <div class="flex-1 min-w-0">
                                <h4 class="text-[13px] font-bold text-ink">{{ trans('pages.cart.free_shipping') }}</h4>
                                <p class="text-[12px] text-gray-500 leading-4">
                                    <span id="free-shipping-msg">{{ (is_free ? trans('pages.cart.has_free_shipping') : trans('pages.cart.free_shipping_alert', {'amount': cart.free_shipping_bar.remaining|money}))|raw }}</span>
                                    <span class="{{ is_free?'':'hidden' }}" id="free-shipping-applied">🎉</span>
                                </p>
                            </div>
                        </div>
                        <div class="mt-4 bg-white rounded-full h-2.5 border border-outline overflow-hidden {{ is_free ? ' hidden' : '' }}" id="free-shipping-bar">
                            <div class="h-full bg-lime rounded-full transition-all duration-700" style="width:{{ cart.free_shipping_bar.percent }}%"></div>
                        </div>
                    </div>
                    
                    {% if loyalty %}
                        <salla-loyalty-panel prize-points='{{ loyalty.prize.points }}' prize-title='{{ loyalty.prize.title }}'></salla-loyalty-panel>
                    {% endif %}
                    
                    <div id="cart-gifting" class="bg-white rounded-[24px] p-3 border border-outline {{gift.enabled ? '' : 'hidden' }}">
                        <salla-gifting id="salla-gifting" widget-title="{{ trans("pages.cart.gift_widget_title") }}" widget-subtitle="{{ gift.text }}" {{gift.type}}-products vertical></salla-gifting>
                    </div>
                    
                    {% if store.settings.cart.apply_coupon_enabled %}
                        <div class="bg-white rounded-[24px] border border-outline p-5">
                            {% hook 'cart:coupon.start' %}
                            <salla-cart-coupons></salla-cart-coupons>
                            {% hook 'cart:coupon.end' %}
                        </div>
                    {% endif %}
                    
                    {% hook 'cart:summary-card.start' %}
                    <div class="bg-white rounded-[32px] border border-outline shadow-elevated overflow-hidden">
                        <div class="p-6">
                            <h3 class="font-display font-bold text-[16px] text-ink mb-1">ملخص الطلب</h3>
                            <p class="text-[12px] text-gray-500 mb-4">الدفع آمن ومشفّر</p>
                            <salla-cart-summary-card></salla-cart-summary-card>
                        </div>
                        <div class="px-6 pb-6 flex items-center justify-center gap-2 text-gray-400">
                            <i class="sicon-lock text-[14px]"></i>
                            <span class="text-[11px] font-bold tracking-wide">دفع آمن · إرجاع 14 يوم · دعم فوري</span>
                        </div>
                    </div>
                    {% hook 'cart:summary-card.end' %}
                    
                    {% hook 'cart:summary.end' %}
                    <salla-tiered-offer></salla-tiered-offer>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script defer src="{{ 'checkout.js' | asset }}"></script>
{% endblock %}
