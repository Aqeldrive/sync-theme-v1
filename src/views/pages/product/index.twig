{% extends "layouts.master" %}
{% block content %}
	{% if theme.settings.get('product_index_show_breadcrumbs', true) %}
		<div class="container container--breadcrumbs relative z-10 pt-4">
			<nav class="breadcrumbs w-full py-4 bg-white/60 glass-panel backdrop-blur-xl border border-white/20 rounded-[1.5rem] px-5 shadow-ambient mb-6">
				<salla-breadcrumb></salla-breadcrumb>
			</nav>
		</div>
	{% endif %}
	<div class="s-blocks-wrapper s-before-products-list !mt-0 relative z-10">{% hook 'product.index.before_products_group_with_filter' %}</div>
	
    <div class="container container--products-list flex items-start flex-col md:flex-row relative z-10">
		{% if filters %}
			<button class="btn--close-sm close-filters sicon-cancel hidden"></button>
			<salla-filters class="md:w-[300px] lg:sticky lg:top-24 flex-none glass-panel rounded-[2rem] border border-white/20 p-6 shadow-ambient bg-white/50" id="filters-menu"></salla-filters>
		{% endif %}
		
        <div class="main-content flex-1 w-full {{ filters ? 'ltr:lg:ml-8 rtl:lg:mr-8' : '' }}">
			
            <div class="glass-panel rounded-[2rem] border border-white/20 p-6 md:p-8 shadow-ambient bg-white/60 mb-6">
                <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
                    <div>
                        <h1 class="font-display text-[30px] md:text-[36px] font-bold tracking-[-0.03em] leading-[0.95] text-ink" id="page-main-title">{{ page.title|raw }}</h1>
                        <div class="w-12 h-1 bg-lime rounded-full mt-4 shadow-glow"></div>
                        {% if category.description %}
                            <p class="text-[14px] leading-6 text-gray-600 mt-3 max-w-[560px]">{{ category.description|raw }}</p>
                        {% endif %}
                    </div>
                    {% if category.image %}
                        <div class="hidden md:block w-24 h-24 rounded-[16px] overflow-hidden border border-white/40 shadow-sm shrink-0">
                            <img src="{{ category.image|cdn(200,200) }}" alt="{{ category.name }}" class="w-full h-full object-cover">
                        </div>
                    {% endif %}
                </div>

                <div class="flex flex-wrap items-center gap-3 mt-6">
                    {% if filters %}
                        <a href="#filters-menu" class="pill-pill lg:hidden">
                            <i class="sicon-filter text-[14px]"></i>
                            {{ trans('pages.categories.filter') }}
                        </a>
                    {% endif %}
                    {% if sort_options|length %}
                        <div class="pill-rail flex-1">
                            {% for sort in sort_options %}
                                <a href="?sort={{ sort.id }}" class="pill-pill {{ sort.is_selected ? 'is-active' : '' }}">
                                    {{ sort.name }}
                                </a>
                            {% endfor %}
                        </div>
                        <div class="hidden md:flex items-center bg-white border border-outline rounded-full px-4 h-[40px] shadow-sm">
                            <label class="hidden sm:block rtl:ml-3 ltr:mr-3 whitespace-nowrap text-[13px] font-bold text-ink" for="product-filter">{{ trans('pages.categories.sorting') }}</label>
                            <select id="product-filter" class="form-input pt-0 pb-0 bg-transparent border-none text-[13px] font-bold text-ink cursor-pointer focus:ring-0">
                                {% for sort in sort_options %}
                                    <option value="{{ sort.id }}" {{ sort.is_selected?'selected':'' }}>{{ sort.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    {% endif %}
                </div>
            </div>
			
            {% hook 'product:index.items.start' %}
			<div class="flex">
				<salla-products-list class="flex-1 min-w-0 overflow-auto stagger" source="{{ page.slug }}" source-value="{{ page.id }}" {{ filters ?'filters-Results':'' }}></salla-products-list>
			</div>
			{% hook 'product:index.items.end' %}
		</div>
	</div>
	
    <div class="s-blocks-wrapper s-after-products-list relative z-10">{% hook 'product.index.after_products_group_with_filter' %}</div>
	
    {% if store.settings.category.testimonial_enabled %}
		{% component 'home.testimonials' %}
	{% endif %}
	
	<div class="s-blocks-wrapper s-after-testimonials relative z-10">{% hook 'product.index.after_testimonials' %}</div>
{% endblock %}
{% block scripts %}
	<script defer src="{{ 'product.js' | asset }}"></script>
{% endblock %}
