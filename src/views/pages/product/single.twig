{% extends "layouts.master" %}

{% block content %}
    <div class="container relative z-10">
        <nav class="breadcrumbs w-full py-3 glass-panel border border-white/55 rounded-[1.5rem] px-5 shadow-ambient mb-6">
            <salla-breadcrumb></salla-breadcrumb>
        </nav>
        
        <div class="flex flex-col items-start lg:flex-row gap-6 lg:gap-10">
            
            {# ——— Gallery — 45% — sticky, editorial ——— #}
            <div class="sidebar w-full lg:w-[46%] lg:sticky lg:top-24">
                {% hook 'product:single.description.start' %}
                
                <div class="glass-panel p-3 rounded-[32px] border border-white/55 shadow-ambient">
                    <salla-slider
                            id="details-slider-{{ product.id }}"
                            class="details-slider rounded-[24px] overflow-hidden block"
                            type="thumbs"
                            listen-to-thumbnails-id="details-slider-thumb-{{ product.id }}">
                        {% hook 'product:single.image.start' %}
                        
                        <div slot="items">
                            {% for image in product.images %}
                                {% if image.three_d_image_url %}
                                    <model-viewer style="min-height: 520px;" class="swiper-slide model-entry w-full h-full"
                                                  src="{{ image.three_d_image_url }}" alt="{{ image.alt }}"
                                                  ar ar-modes="webxr scene-viewer quick-look" environment-image="neutral"
                                                  auto-rotate camera-controls></model-viewer>
                                {% elseif image.video_url %}
                                    <div class="swiper-slide video-entry">
                                        <a data-fslightbox="product_{{ product.id }}" data-type="youtube" href="{{ image.video_url }}">
                                            <div class="product-video__bg relative">
                                                <img src="{{ image.url }}" alt="{{ image.alt }}" class="w-full h-full object-cover">
                                                <i class="sicon-play-video absolute inset-0 flex items-center justify-center font-bold text-6xl text-white drop-shadow-lg"></i>
                                            </div>
                                        </a>
                                    </div>
                                {% else %}
                                    <a data-fslightbox="product_{{ product.id }}" data-img-id="{{ image.id }}" data-slid-index="{{ loop.index -1 }}"
                                       {% if image.alt %}data-caption="{{ image.alt }}"{% endif %}
                                       class="swiper-slide magnify-wrapper cursor-zoom-in group block" href="{{ image.url }}"
                                       aria-label="{{ product.name }}">
                                        <img src="{{ image.url }}" alt="{{ image.alt }}"
                                             class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]">
                                    </a>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </salla-slider>
                </div>

                {% if product.images|length > 1 %}
                    <div class="mt-3">
                        <salla-slider
                                type="thumbnails"
                                id="details-slider-thumb-{{ product.id }}"
                                data-id="details-slider-{{ product.id }}"
                                class="details-slider-thumb"
                                slides-per-view="5"
                                space-between="10"
                                listen-to-thumbnails-id="details-slider-thumb-{{ product.id }}">
                            <div slot="items">
                                {% for image in product.images %}
                                    <div class="swiper-slide !h-[84px] !w-[84px] rounded-[16px] overflow-hidden glass-panel border border-white/40 cursor-pointer opacity-60 transition-all hover:opacity-100 hover:border-lime/40 hover:shadow-ambient">
                                        {% if image.video_url %}
                                            <div class="product-video__bg w-full h-full relative">
                                                <img src="{{ image.url }}" alt="{{ image.alt }}" class="w-full h-full object-cover">
                                                <i class="sicon-play-video absolute inset-0 flex items-center justify-center font-bold text-xl text-white"></i>
                                            </div>
                                        {% else %}
                                            <img src="{{ image.url }}" alt="{{ image.alt }}" class="w-full h-full object-cover">
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        </salla-slider>
                    </div>
                {% endif %}
                
                {% hook 'product:single.image.end' %}
            </div>

            {# ——— Info — 55% — editorial, tabular pricing, luxury ATC ——— #}
            <div class="main-content w-full lg:w-[54%] glass-panel rounded-[32px] border border-white/55 p-6 md:p-8 lg:p-10">
                <div class="flex justify-between items-start gap-4 mb-5">
                    <div class="flex-1 min-w-0">
                        {% if product.brand.name %}
                            <a href="{{ product.brand.url }}" class="inline-flex items-center gap-2 text-[11px] font-bold tracking-[0.12em] uppercase text-gray-500 bg-white border border-outline px-3 py-1 rounded-full hover:border-ink/20 hover:text-ink transition-colors">
                                {{ product.brand.name }}
                            </a>
                        {% endif %}
                        <h1 class="font-display text-[30px] md:text-[36px] font-bold tracking-[-0.03em] leading-[0.95] text-ink mt-3">
                            {{ product.name }}
                        </h1>
                        <div class="w-12 h-1 bg-lime rounded-full mt-4 shadow-glow"></div>
                    </div>
                    
                    <salla-button type="favorite" product-id="{{ product.id }}" class="shrink-0 w-11 h-11 glass-panel border border-white/50 rounded-full flex items-center justify-center text-ink hover:text-red-500 hover:bg-white transition-all shadow-sm">
                        <i class="sicon-heart text-[20px]"></i>
                    </salla-button>
                </div>
                
                {% if product.subtitle %}
                    <p class="text-[14px] leading-6 text-gray-600 mb-4">{{ product.subtitle }}</p>
                {% endif %}

                {% if product.rating %}
                    <div class="inline-flex items-center gap-2 bg-white border border-outline px-3 py-1.5 rounded-full mb-4">
                        <i class="sicon-star text-yellow-400 text-[14px]"></i>
                        <span class="text-[13px] font-bold text-ink tabular-nums">{{ product.rating.stars }}</span>
                        <span class="text-[12px] text-gray-400">({{ product.rating.count }})</span>
                    </div>
                {% endif %}
                
                {% if product.sku %}
                    <p class="text-[11px] tracking-[0.08em] font-bold text-gray-400 uppercase mb-4">SKU {{ product.sku }} · توصيل خلال 2-4 أيام</p>
                {% endif %}

                {% if product.description %}
                    <div class="prose prose-sm max-w-none text-[14px] leading-7 text-gray-600 mb-6 prose-a:text-ink prose-a:underline">
                        {{ product.description|raw }}
                    </div>
                {% endif %}

                <form class="form product-form space-y-6" enctype="multipart/form-data" method="post"
                      onsubmit="return salla.form.onSubmit('cart.addItem', event)">
                    <input type="hidden" name="id" value="{{ product.id }}">
                    
                    {% hook 'product:single.form.start' %}
                    
                    <div class="glass-panel rounded-[24px] p-5 border border-white/55">
                        {% include 'pages.partials.product.options' %}
                    </div>
                    
                    {% hook 'product:single.form.end' %}
                    
                    <section class="glass-panel rounded-[32px] p-6 md:p-7 border border-white/55 space-y-5">
                        
                        <div class="flex justify-between items-end">
                            <span class="text-[11px] font-bold tracking-[0.1em] uppercase text-gray-400">{{ trans('pages.products.price') }}</span>
                            <div class="flex whitespace-nowrap price-wrapper gap-3 items-baseline">
                              <div class="{{ product.is_on_sale ? '' : 'hidden' }} price_is_on_sale flex items-baseline gap-3">
                                <span class="total-price text-forest font-display text-[32px] font-bold tabular-nums leading-none">{{product.sale_price|money}}</span>
                                <span class="before-price text-gray-400 text-[13px] line-through tabular-nums">{{product.regular_price|money}}</span>
                              </div>
                              <div class="starting-or-normal-price gap-2 {{ product.is_on_sale ? 'hidden' : 'flex' }} items-baseline">
                                {% if product.starting_price %}
                                   <span class="starting-price-title text-[12px] text-gray-400">{{ trans('pages.products.starting_price') }}</span>
                                {% endif %}
                                 <span class="total-price font-display text-[32px] text-ink font-bold tabular-nums leading-none"> {{product.starting_price ? product.starting_price|money : product.price|money }}</span>
                              </div>
                            </div>
                        </div>
                        
                        <div class="h-px bg-outline/60"></div>
                        
                        <div class="flex flex-col sm:flex-row gap-3">
                            {% if product.is_hidden_quantity or product.type == 'booking' %}
                                <input type="hidden" value="1" name="quantity" aria-label="Quantity"/>
                            {% else %}
                                <div class="w-full sm:w-[132px] flex items-center bg-paper border border-outline rounded-full px-1 h-[52px]">
                                    <salla-quantity-input max="{{ product.max_quantity }}" value="1" name="quantity" aria-label="Quantity"
                                      class="w-full bg-transparent flex justify-center"></salla-quantity-input>
                                </div>
                            {% endif %}
                            
                            <div class="flex-1">
                                <salla-add-product-button
                                        {{product.can_quick_buy ? 'quick-buy' : ''}}
                                        {{theme.settings.get('sticky_add_to_cart') ? ' support-sticky-bar' : ''}}
                                        {{product.is_require_shipping ? 'required-shipping' : ''}}
                                        amount="{{ product.base_currency_price }}"
                                        class="w-full h-[52px] rounded-full"
                                        product-status="{{ product.status }}"
                                        product-type="{{ product.type }}"
                                        product-id="{{ product.id }}"
                                        loader-position="end"
                                        type="submit"
                                        width="wide"
                                        {% if product.notify_availability %}
                                            {{ product.notify_availability.subscribed ? 'is-subscribed' : '' }}
                                            channels="{{ product.notify_availability.channels|join(',') }}"
                                            subscribed-options="{{ product.notify_availability.subscribed_options|json_encode }}"
                                            {{ product.notify_availability.options ? 'notify-options-availability' : '' }}
                                        {% endif %}>
                                    <span class="btn-atelier-primary w-full h-full text-[15px]">
                                        {{ product.add_to_cart_label }}
                                    </span>
                                </salla-add-product-button>
                            </div>
                        </div>

                        {# Trust row — luxury proof #}
                        <div class="grid grid-cols-3 gap-3 pt-2">
                            <div class="flex flex-col items-center gap-1.5 bg-paper rounded-[16px] border border-outline/60 py-3">
                                <i class="sicon-shield text-ink text-[18px]"></i>
                                <span class="text-[11px] font-bold tracking-wide text-ink">أصلي 100%</span>
                                <span class="text-[10px] text-gray-400">Authentic</span>
                            </div>
                            <div class="flex flex-col items-center gap-1.5 bg-paper rounded-[16px] border border-outline/60 py-3">
                                <i class="sicon-shipping-fast text-ink text-[18px]"></i>
                                <span class="text-[11px] font-bold tracking-wide text-ink">شحن سريع</span>
                                <span class="text-[10px] text-gray-400">Fast shipping</span>
                            </div>
                            <div class="flex flex-col items-center gap-1.5 bg-paper rounded-[16px] border border-outline/60 py-3">
                                <i class="sicon-undo text-ink text-[18px]"></i>
                                <span class="text-[11px] font-bold tracking-wide text-ink">إرجاع سهل</span>
                                <span class="text-[10px] text-gray-400">Easy returns</span>
                            </div>
                        </div>
                    </section>
                </form>
                
                {% hook 'product:single.description.end' %}
            </div>
        </div>
        
        <div class="s-blocks-wrapper s-before-reviews mt-12">{% hook 'product.single.before_customer_reviews' %}</div>
        
        {% if store.settings.rating.show_on_product %}
            <salla-comments item-id="{{product.id}}" type="product" class="glass-panel p-6 md:p-8 rounded-[32px] border border-white/55 mt-6 block"></salla-comments>
        {% endif %}
        
        <div class="s-blocks-wrapper s-before-related mt-12">{% hook 'product.single.before_product_recommendations' %}</div>
        
        <div class="mt-12">
            <div class="text-center mb-8">
                <h2 class="font-display text-[26px] md:text-[32px] font-bold tracking-[-0.03em] text-ink">{{trans('pages.products.similar_products')}}</h2>
                <div class="w-12 h-1 bg-lime rounded-full mx-auto mt-3 shadow-glow"></div>
            </div>
            <salla-products-slider source="related" source-value="{{product.id}}" display-all-url></salla-products-slider>
        </div>
        
        <div class="s-blocks-wrapper s-after-related">{% hook 'product.single.after_product_recommendations' %}</div>
    </div>

{# ——— Hover preview: touch/hover thumbnail -> main slider changes without clicking arrows ——— #}
<script>
// CEO HOVER DELEGATION — touch/hover = preview instantly, no press needed
  const thumbId = 'details-slider-thumb-{{ product.id }}';
  const mainId = 'details-slider-{{ product.id }}';
  function bindHover(){
    const thumb = document.getElementById(thumbId);
    const main = document.getElementById(mainId);
    if(!thumb) return;
    // delegation: any pointer over thumb slide triggers
    thumb.addEventListener('pointerenter', (e)=>{
      const slide = e.target.closest('.swiper-slide');
      if(!slide) return;
      const idx = Array.from(thumb.querySelectorAll('.swiper-slide')).indexOf(slide);
      if(idx<0) return;
      try{
        if(main && main.swiper) { main.swiper.slideTo(idx); }
        else if(window.salla && salla.event) { slide.click(); }
        else slide.click();
      }catch(err){ slide.click(); }
      slide.dispatchEvent(new MouseEvent('click', {bubbles:true}));
    }, true);
    thumb.addEventListener('touchstart', (e)=>{
      const slide = e.target.closest('.swiper-slide');
      if(slide) slide.click();
    }, {passive:true});
    // keep active styling synced
    const obs = new MutationObserver(()=>{
      thumb.querySelectorAll('.swiper-slide').forEach(s=> s.classList.remove('thumb-active'));
      const active = thumb.querySelector('.swiper-slide-thumb-active, .swiper-slide-active');
      if(active) active.classList.add('thumb-active');
    });
    obs.observe(thumb, {attributes:true, subtree:true, attributeFilter:['class']});
  }
  let tries=0; const iv=setInterval(()=>{ bindHover(); const t=document.getElementById(thumbId); if(t && t.querySelector('.swiper-slide') || tries++>25) clearInterval(iv); }, 350);
</script>
<style>
#details-slider-thumb-{{ product.id }} .swiper-slide{ transition: all 0.25s cubic-bezier(0.16,1,0.3,1); }
#details-slider-thumb-{{ product.id }} .swiper-slide:hover{ opacity:1 !important; border-color: rgba(212,255,0,0.45) !important; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(10,24,52,0.10); }
#details-slider-thumb-{{ product.id }} .swiper-slide.thumb-active, #details-slider-thumb-{{ product.id }} .swiper-slide.swiper-slide-thumb-active{ opacity:1 !important; border-color: #D4FF00 !important; box-shadow: 0 0 0 2px rgba(212,255,0,0.22), 0 8px 20px rgba(212,255,0,0.18) !important; transform: translateY(-1px); }
.dark-mode-enabled #details-slider-thumb-{{ product.id }} .swiper-slide{ border-color: rgba(255,255,255,0.14) !important; }
</style>

{% endblock %}

{% block scripts %}
    <script defer src="{{ 'product.js' | asset }}"></script>
    {% if product.has_3d_image %}
        <script type="module" defer src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
    {% endif %}
    {% if product.digital_files_settings %}
        <script type="module" defer src="{{ 'digital-files.js'|asset }}"></script>
    {% endif %}
{% endblock %}
