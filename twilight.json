{
  "name": {
    "en": "sync-theme-v1",
    "ar": "زم السync"
  },
  "features": [
    "mega-menu",
    "fonts",
    "color",
    "breadcrumb",
    "unite-cards-height",
    "component-featured-products",
    "component-fixed-banner",
    "component-fixed-products",
    "component-photos-slider",
    "component-products-slider",
    "component-parallax-background",
    "component-random-testimonials",
    "component-testimonials",
    "component-square-photos",
    "component-store-features",
    "component-youtube",
    "component-smart-recommendations",
    "component-live-price-updates",
    "component-vr-product-viewer",
    "component-ar-try-on",
    "component-dynamic-pricing",
    "component-subscription-management",
    "component-preorder-2050",
    "component-crypto-payments",
    "component-social-commerce",
    "component-live-shopping",
    "component-flash-sales-intelligent",
    "component-back-in-stock-intelligent",
    "component-wishlist-intelligent",
    "component-cart-recovery",
    "component-price-comparison",
    "component-sustainability-score"
  ],
  "settings": [
    {
      "id": "glassmorphism",
      "type": "boolean",
      "format": "switch",
      "value": true,
      "selected": true
    },
    {
      "id": "dark_mode",
      "type": "boolean",
      "format": "switch",
      "value": true,
      "selected": true
    },
    {
      "id": "header_is_sticky",
      "type": "boolean",
      "format": "switch",
      "value": true,
      "selected": true
    },
    {
      "id": "footer_is_dark",
      "type": "boolean",
      "format": "switch",
      "value": true,
      "selected": false
    },
    {
      "id": "sticky_add_to_cart",
      "type": "boolean",
      "format": "switch",
      "value": true,
      "selected": true
    },
    {
      "id": "enable_more_menu",
      "type": "boolean",
      "format": "switch",
      "value": true,
      "selected": true
    },
    {
      "id": "show_tags",
      "type": "boolean",
      "format": "switch",
      "value": true,
      "selected": true
    },
    {
      "id": "is_more_button_enabled",
      "type": "boolean",
      "format": "switch",
      "value": true,
      "selected": true
    },
    {
      "id": "ai_recommendations",
      "type": "boolean",
      "format": "switch",
      "value": true,
      "selected": true,
      "label": "AI-powered product recommendations",
      "description": "Artificial intelligence suggests products based on browsing behavior"
    },
    {
      "id": "ar_try_on",
      "type": "boolean",
      "format": "switch",
      "value": true,
      "selected": true,
      "label": "Augmented reality try-on",
      "description": "Visualize products in your space or try virtually"
    },
    {
      "id": "crypto_payment",
      "type": "boolean",
      "format": "switch",
      "value": false,
      "selected": false,
      "label": "Cryptocurrency payments",
      "description": "Accept Bitcoin, Ethereum, and other cryptocurrencies"
    },
    {
      "id": "live_shopping",
      "type": "boolean",
      "format": "switch",
      "value": false,
      "selected": false,
      "label": "Live shopping streams",
      "description": "Real-time product showcases with interactive chat"
    },
    {
      "id": "dynamic_pricing",
      "type": "boolean",
      "format": "switch",
      "value": false,
      "selected": false,
      "label": "AI dynamic pricing",
      "description": "Prices adjust based on demand, time, and user behavior"
    },
    {
      "id": "smart_collections",
      "type": "boolean",
      "format": "switch",
      "value": true,
      "selected": true,
      "label": "Smart product collections",
      "description": "AI-organized product groupings based on behavior"
    },
    {
      "id": "sustainability_score",
      "type": "boolean",
      "format": "switch",
      "value": true,
      "selected": true,
      "label": "Eco-friendliness score",
      "description": "Show environmental impact of products"
    }
  ],
  "components": [
    {
      "key": "1",
      "title": {
        "en": "Smart Recommendations",
        "ar": "التوصيات الذكية"
      },
      "icon": "sicon-brain",
      "path": "home.smart-recommendations",
      "image": "https://cdn.salla.network/images/themes/raed/preview-images/smart-recs.png?v=2.0",
      "is_default": true,
      "fields": [
        {
          "id": "slides",
          "type": "collection",
          "format": "collection",
          "label": "المنتجات الموصى بها",
          "fields": [
            {
              "id": "slides.image",
              "type": "string",
              "format": "image"
            },
            {
              "id": "slides.title",
              "type": "string",
              "format": "text"
            },
            {
              "id": "slides.description",
              "type": "string",
              "format": "textarea"
            }
          ],
          "item_label": "منتج",
          "minLength": 1,
          "maxLength": 8
        }
      ]
    },
    {
      "key": "2",
      "title": {
        "en": "AR Try-On",
        "ar": "تجربة الواقع المعزز"
      },
      "icon": "sicon-vr",
      "path": "home.ar-try-on",
      "image": "https://cdn.salla.network/images/themes/raed/preview-ar.png?v=2.0",
      "fields": [
        {
          "id": "ar_model",
          "type": "string",
          "format": "text",
          "label": "النموذج ثلاثي الأبعاد"
        },
        {
          "id": "ar_image",
          "type": "string",
          "format": "image",
          "label": "الصورة الظاهرية"
        }
      ]
    },
    {
      "key": "3",
      "title": {
        "en": "Live Price Updates",
        "ar": "تحديثات الأسعار الحية"
      },
      "icon": "sicon-chart",
      "path": "home.live-price",
      "fields": [
        {
          "id": "price_history",
          "type": "collection",
          "format": "collection",
          "label": "تاريخ السعر",
          "fields": [
            {
              "id": "price.image",
              "type": "string",
              "format": "image"
            },
            {
              "id": "price.title",
              "type": "string",
              "format": "text"
            },
            {
              "id": "price.date",
              "type": "string",
              "format": "date"
            },
            {
              "id": "price.amount",
              "type": "number",
              "format": "integer"
            }
          ],
          "item_label": "سجل",
          "minLength": 1,
          "maxLength": 52
        }
      ]
    },
    {
      "key": "4",
      "title": {
        "en": "Featured Products",
        "ar": "منتجات مميزة"
      },
      "icon": "sicon-star",
      "path": "home.featured-products",
      "fields": [
        {
          "id": "title",
          "type": "string",
          "format": "text",
          "label": "عنوان القسم"
        },
        {
          "id": "products",
          "type": "items",
          "format": "dropdown-list",
          "source": "products",
          "multichoice": true,
          "searchable": true
        }
      ]
    },
    {
      "key": "5",
      "title": {
        "en": "Wide Banner",
        "ar": "البنر العريض"
      },
      "icon": "sicon-image",
      "path": "home.wide-banner",
      "fields": [
        {
          "id": "image",
          "type": "string",
          "format": "image",
          "label": "صورة البنر"
        },
        {
          "id": "url",
          "type": "string",
          "format": "text",
          "label": "رابط البنر"
        }
      ]
    }
  ],
  "repository": "https://github.com/Aqeldrive/theme_ona",
  "author_email": "aqel.drive@gmail.com",
  "support_url": "https://github.com/Aqeldrive/theme_ona/issues",
  "description": {
    "en": "ONA Theme",
    "ar": "ثيم أونا"
  }
}